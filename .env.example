# Copy to .env and adjust
# Long random string, e.g. generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Development: local SQLite file. Production: postgres://user:pass@host:5432/paywand
DATABASE_URL=file:./paywand.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Email (optional – without SMTP, emails are logged to the console in dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@paywand-berlin.de
